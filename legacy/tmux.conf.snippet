# tmux-attn integration

# Optional: move tmux status bar to the top.
set -g status-position top

# Re-evaluate status commands periodically.
set -g status-interval 15

# Show whether anything currently needs attention.
# Append this to your existing status-right if you already have one.
set -g status-right '#($HOME/.local/bin/tmux-attn status) | %H:%M'

# Prefix + a -> attention queue in a popup.
bind-key a display-popup -E -w 95% -h 90% -T 'tmux attention' '$HOME/.local/bin/tmux-attn'

# Fallback for older/custom environments if you do not want a popup:
# bind-key A new-window -n tmux-attn '$HOME/.local/bin/tmux-attn'
