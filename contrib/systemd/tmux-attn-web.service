[Unit]
Description=tmux-attn web panel (__HOST__:__PORT__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tmux-attn web __HOST__ __PORT__
__ENVIRONMENT__
Restart=on-failure
RestartSec=2
KillMode=process

# Optional overrides via environment:
#   systemctl --user edit tmux-attn-web
#   Environment=TMUX_ATTN_HOST=my-laptop

[Install]
WantedBy=default.target
