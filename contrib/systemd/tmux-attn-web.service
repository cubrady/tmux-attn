[Unit]
Description=tmux-attn web panel (__HOST__:__PORT__)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tmux-attn web __HOST__ __PORT__
__ENVIRONMENT__
# always: SIGTERM is "clean" under on-failure, so external TERM (memory
# pressure / stray kill) would leave the panel down until manual start.
Restart=always
RestartSec=2
# control-group: process mode orphans snapshot-worker after the main PID dies.
KillMode=control-group

# Optional overrides via environment:
#   systemctl --user edit tmux-attn-web
#   Environment=TMUX_ATTN_HOST=my-laptop

[Install]
WantedBy=default.target
